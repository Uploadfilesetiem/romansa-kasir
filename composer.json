{
    "name": "romansa/kasir-roti-bakar",
    "type": "project",
    "description": "Kasir Roti Bakar Romansa - Laravel + SQLite, jalan langsung di HP lewat Termux.",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "*",
                "PKSA-3r5d-mb8f-1qw9": "*",
                "PKSA-mdq4-51ck-6kdq": "*",
                "PKSA-8qx3-n5y5-vvnd": "*",
                "PKSA-w7xr-vk7n-rstm": "*"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}